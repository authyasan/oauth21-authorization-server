{
	"name": "oauth21-server",
	"version": "0.1.0",
	"description": "OAuth 2.1準拠の認可サーバー実装",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test -c test/e2e/playwright.config.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/db/seed.ts",
		"generate-keys": "tsx scripts/generate-keys.ts"
	},
	"keywords": [
		"oauth",
		"oauth2.1",
		"authorization-server"
	],
	"license": "MIT",
	"dependencies": {
		"@hono/node-server": "^2.1.9",
		"bcryptjs": "^3.0.3",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.19",
		"jose": "^6.2.13",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=26.13.1 <27"
	},
	"volta": {
		"node": "26.13.1"
	}
}
